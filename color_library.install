<?php
/**
 * Implements hook_schema().
 */
function color_library_schema() {
  $schema['color'] = [
    'description' => 'The base table for Color entities..',
    'fields' => [
      'cid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique User Color ID.',
      ],
      'uuid' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Unique UUID.',
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color.',
      ],
      'hexadecimal' => [
        'type' => 'varchar',
        'length' => 7,
        'not null' => TRUE,
        'description' => 'The hexadecimal value of the color.',
      ],
      'css_variable_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color.',
      ],
      'tags' => [
          'type' => 'varchar',
          'length' => 255,
          'description' => 'Tags associated with the color.',
      ],
    ],
    'primary key' => ['cid'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'name' => ['name'],
    ],
  ];
  $schema['color_palette'] = [
    'description' => 'Stores Color Palette entities.',
    'fields' => [
      'id' => [ // ID field
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique Color Palette ID.',
      ],
      'uuid' => [ // UUID field
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Unique UUID.',
      ],
      'name' => [ // Name field
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color palette.',
      ],
      'colors' => [
        'type' => 'blob',
        'not null' => FALSE,
        'description' => 'Serialized array of referenced color IDs.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'name' => ['name'],
    ],
  ];

  return $schema;
}


/**
 * Implements hook_install().
 * Install the color palette icon block no matter what theme is being used
 * @todo: add something to reinstall this from the config menu
 */
function color_library_install() {
  $block_id = 'color_palette_accessory';
  $system_theme = \Drupal::config('system.theme')->get('admin');
  $region = _color_library_find_admin_region($system_theme); // Helper function (defined below)
  if ($region) {
    // Place the block programmatically.
    $block = \Drupal\block\Entity\Block::load($block_id);
    if ($block) {
      $block->setRegion($region);
      $block->save();
    }
  }
  else {
    \Drupal::logger('color_library')->warning(t('Could not find a suitable admin region to place the block.'));
  }
}

/**
 * Helper function to find a suitable admin region.
 */
function _color_library_find_admin_region($theme_name = NULL) {
  $regions = [
    'content',
    'admin_header',
    'content_top',
    'content_bottom',
    'page_top',
    'page_bottom',
    'footer',
  ];
  // List all admin themes.
  $theme_regions = system_region_list($theme_name);
    foreach ($regions as $region) {
      if (isset($theme_regions[$region])) {
        return $region;
      }
    }
  return FALSE;
}
