<?php
/**
 * Implements hook_schema().
 */
function color_library_schema() {
  $schema['color'] = [
    'description' => 'The base table for Color entities.',
    'fields' => [
      'cid' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique User Color machine name.',
      ],
      'uuid' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Unique UUID.',
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color.',
      ],
      'hexadecimal' => [
        'type' => 'varchar',
        'length' => 7,
        'not null' => TRUE,
        'description' => 'The hexadecimal value of the color.',
      ],
      'css_variable_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color.',
      ],
      'tags' => [
          'type' => 'varchar',
          'length' => 255,
          'description' => 'Tags associated with the color.',
      ],
    ],
    'primary key' => ['cid'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'name' => ['name'],
    ],
  ];
  $schema['color_palette'] = [
    'description' => 'Stores Color Palette entities.',
    'fields' => [
      'id' => [ // ID field
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique Color Palette ID.',
      ],
      'uuid' => [ // UUID field
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Unique UUID.',
      ],
      'name' => [ // Name field
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The name of the color palette.',
      ],
      'colors' => [
        'type' => 'blob',
        'not null' => FALSE,
        'description' => 'Serialized array of referenced color IDs.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uuid' => ['uuid'],
    ],
    'indexes' => [
      'name' => ['name'],
    ],
  ];

  return $schema;
}


/**
 * Implements hook_install().
 * Install the color palette icon block no matter what theme is being used
 * @todo: add an option to reinstall this from the config menu
 */
function color_library_install() {
  $block_id = 'color_palette_accessory';
  $system_theme = \Drupal::config('system.theme')->get('admin');
  $region = _color_library_find_admin_region($system_theme); // Helper function (defined below)
  if ($region) {
    // Place the block programmatically.
    $block = \Drupal\block\Entity\Block::load($block_id);
    if ($block) {
      $block->setRegion($region);
      $block->save();
    }
  }
  else {
    \Drupal::logger('color_library')->warning(t('Could not find a suitable admin region to place the block.'));
  }
  _color_library_websafe_colors_install();
}

/**
 * Helper function to find a suitable admin region.
 */
function _color_library_find_admin_region($theme_name = NULL) {
  // these are the most common regions in themes though themes can override or remove these
  $regions = [
    'content',
    'admin_header',
    'content_top',
    'content_bottom',
    'page_top',
    'page_bottom',
    'footer',
  ];
  // List all admin them regions
  $theme_regions = system_region_list($theme_name);
    foreach ($regions as $region) {
      if (isset($theme_regions[$region])) {
        return $region;
      }
    }
  return FALSE;
}

/**
 * Installs the color entities from a JSON file.
 * Reads a JSON file containing web-safe colors and creates or updates color
 * entities in the system based on the data provided in the file.
 *
 * @param \Symfony\Component\DependencyInjection\ContainerInterface $container
 *   The service container to retrieve the necessary services, such as the
 *   entity type manager.
 *
 * @return void
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function _color_library_websafe_colors_install() {;
  $storage = \Drupal::entityTypeManager()->getStorage('color');
  $json_path = \Drupal::service('extension.path.resolver')->getPath('module', 'color_library')
    . '/src/websafe_colors.json';
  $json_data = file_get_contents($json_path);
  $colors = json_decode($json_data, TRUE);
  if (is_array($colors)) {
    foreach ($colors as $color_hex => $color_name) {
      // Check if a color entity with this ID already exists.
      $color_id = strtolower(str_replace(' ', '_', $color_name));
      $existing_entities = $storage->loadByProperties(['cid' => $color_id]); // Use ID here
      print_r($color_id);
      if (empty($existing_entities)) {
        // Create a new color entity.
        $color_entity = $storage->create([
          'cid' => $color_id, // Use the color ID from the JSON as the entity ID.
          'name' => $color_name,
          'hexadecimal' => $color_hex,
          'readonly' => TRUE,
          'css_variable_name' => $color_name,
          'tags' => 'web-safe'
          // Add other fields as needed.
        ]);
        // Save the entity to the database.
        $color_entity->save();
      }
      else {
        // If the entity exists, you could update it, or do nothing.
        $existing_entity = reset($existing_entities); //Get the first element of the array.
        $existing_entity->setName($color_name);
        $existing_entity->setHexValue($color_hex);
        $existing_entity->save();
      }
    }
  }
}

/**
 * Implements hook_uninstall().
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
 * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
 */
function color_library_preuninstall() {
  $entity_type_manager = \Drupal::entityTypeManager();
  try {
    $storage = $entity_type_manager->getStorage('color');
  }
  catch (\Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException $e) {
    throw new \Drupal\Component\Plugin\Exception\PluginNotFoundException($e->getMessage());
  }
  catch (\Drupal\Component\Plugin\Exception\PluginNotFoundException $e) {
    throw new \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException($e->getMessage());
  }
  // Select all color entities.
  $entity_ids = $storage->getQuery()
    ->accessCheck(FALSE) // Important: Disable access checks for uninstall.
    ->execute();

  // Load the entities.
  $entities = $storage->loadMultiple($entity_ids);
  // Delete the entities in a batch.
  if (!empty($entities)) {
    $storage->delete($entities);
  }
  //  Delete any field data
  $field_storages = $entity_type_manager->getStorage('field_storage_config')->loadByProperties(['entity_type' => 'color']);
  foreach ($field_storages as $field_storage) {
    $field_storage->delete();
  }
  $entity_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = $entity_update_manager->getEntityType('color');
  $entity_update_manager->uninstallEntityType($entity_type);
  $entity_type_manager->clearCachedDefinitions();
}
